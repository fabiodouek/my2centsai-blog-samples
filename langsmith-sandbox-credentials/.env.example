# LangSmith API key with sandbox permissions, and the endpoint for your region
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Read once by 01_setup_secrets.py and stored as LangSmith workspace secrets. Never sent into a sandbox.
ANTHROPIC_API_KEY=sk-ant-...
# Fine-grained PAT scoped to GITHUB_REPO only: Contents and Pull requests, read and write
GITHUB_TOKEN=github_pat_...
# A throwaway repo the demo can push branches and open PRs on, as owner/name
GITHUB_REPO=you/your-test-repo

# 08_aws_role.py: the IAM role trusted through LangSmith's OIDC issuer, and a test bucket (see README)
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/my2cents-langsmith-sandbox
AWS_LS_BUCKET=your-throwaway-bucket
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
