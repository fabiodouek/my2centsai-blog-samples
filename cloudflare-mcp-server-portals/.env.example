# Copy to .env (never commit it). The token needs: Workers Scripts Write, Access: Apps and Policies Write,
# Access: Service Tokens Write, MCP Portals Write, and DNS Write on the zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# A domain that is an active zone on that account, and your workers.dev subdomain
LAB_DOMAIN=example.com
WORKERS_SUBDOMAIN=your-subdomain
