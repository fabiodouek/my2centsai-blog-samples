# Get a key at https://e2b.dev/dashboard
E2B_API_KEY=

# Read once by 01_setup_secrets.py and stored as E2B Secrets. Never sent into a sandbox.
ANTHROPIC_API_KEY=
# Fine-grained PAT (or GitHub App installation token) scoped to GITHUB_REPO only:
# Contents: read and write, Pull requests: read and write.
GITHUB_TOKEN=
# A throwaway repo the demo can push branches and open PRs on, as owner/name.
GITHUB_REPO=
