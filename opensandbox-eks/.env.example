# Copy to .env (gitignored) or let the scripts create it. Never commit .env.

# The OpenSandbox server API key (header OPEN-SANDBOX-API-KEY). 04_install.sh stores it in the
# Secret opensandbox-server-auth. Leave it empty and 04_install.sh generates a random key and
# writes it here. At least 16 characters: letters, digits and . _ ~ + / = -
OSB_API_KEY=

# The developer console (06_console.sh). Leave both empty and 06_console.sh deploy generates them
# and writes them here. BFF_SESSION_SECRET signs the console's session cookie (64 hex characters);
# BFF_ADMIN_TOKEN is the password for the console's admin login. The developer login uses OSB_API_KEY.
BFF_SESSION_SECRET=
BFF_ADMIN_TOKEN=
