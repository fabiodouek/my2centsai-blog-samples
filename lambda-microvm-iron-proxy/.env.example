# Uploaded to AWS Secrets Manager by 01_setup.py. Never sent into a MicroVM.
ANTHROPIC_API_KEY=sk-ant-...
# Fine-grained PAT scoped to GITHUB_REPO only: Contents read/write, Pull requests read/write
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=your-user/your-test-repo
AWS_REGION=us-east-1
# Set to 0 to print account IDs, bucket names, secret ARNs and the NAT's public IP unredacted
REDACT=1
# Optional: a lock directory shared with other projects in the same account (mkdir = take it), so their
# MicroVMs don't exceed the account's MicroVM memory quota together
# Leave it unset for no locking. When set, the scripts only proceed while the lock's owner file starts with
# "lambda-microvm-iron-proxy (my2cents-ip)" (they write that themselves), so don't point it at a lock someone else holds
# MVM_LOCK=/tmp/aws.lock
