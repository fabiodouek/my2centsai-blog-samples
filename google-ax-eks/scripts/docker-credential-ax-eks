#!/usr/bin/env bash
# Docker credential helper for the ECR registry these scripts push to: hands
# out a fresh `aws ecr get-login-password` token, never stores anything.
# env.sh points credHelpers at it for that one registry.
set -euo pipefail
case "${1:-}" in
  get)
    read -r server || true  # docker sends no trailing newline
    host="${server#https://}"
    region="$(cut -d. -f4 <<<"$host")"
    printf '{"ServerURL":"%s","Username":"AWS","Secret":"%s"}\n' \
      "$server" "$(aws ecr get-login-password --region "$region")"
    ;;
  store|erase) cat >/dev/null ;;
  list) echo '{}' ;;
esac
