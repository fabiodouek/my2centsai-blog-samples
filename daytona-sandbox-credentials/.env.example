# https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=dtn_your_key_here
DAYTONA_TARGET=us

# Read once by 01_setup_secrets.py and stored as Daytona Secrets. Never sent into a sandbox.
ANTHROPIC_API_KEY=sk-ant-...
# Fine-grained PAT scoped to GITHUB_REPO only: Contents and Pull requests, read and write
GITHUB_TOKEN=github_pat_...
# A throwaway repo the demo can push branches and open PRs on, as owner/name
GITHUB_REPO=you/your-test-repo
# Test 7: the user the other tests run as, and a GitHub App (Device Flow enabled, installed on GITHUB_REPO)
# whose user tokens become a second user's secrets. The client ID is public; no client secret is needed.
DEMO_USER=alice
GITHUB_APP_CLIENT_ID=Iv23...

# AWS: a profile allowed to call Bedrock. 01_setup_secrets.py mints a 12-hour Bedrock API key from it.
AWS_PROFILE=default
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Bucket for the S3 test (09_s3_sigv4.py). Created and deleted by that script.
AWS_TEST_BUCKET=your-throwaway-bucket-name
